# Variables de entorno sensibles (Se entregan empaquetadas en ZIP)
.env
backend/.env

# Dataset local (se preservan marcadores de estructura)
backend/ml/dataset/con_corbata/*
backend/ml/dataset/sin_corbata/*
!backend/ml/dataset/.gitkeep
!backend/ml/dataset/**/sample_*

# Artefactos y Pesos de Modelos Entrenados (REQUERIDO EN REPO: .pt y .pkl incluidos)
backend/ml/models/*
!backend/ml/models/.gitkeep
!backend/ml/models/*.pkl
!backend/ml/models/*.pt

# Node-RED: Flujo exportado y configuración requerida
node-red-data/*
!node-red-data/flows.json
!node-red-data/package.json
!node-red-data/.gitkeep
node-red-data/node_modules/
node-red-data/.config.json*
node-red-data/.sessions.json*
