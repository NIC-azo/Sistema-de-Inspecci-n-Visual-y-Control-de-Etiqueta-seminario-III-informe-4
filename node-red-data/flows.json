  {
    "id": "http_in_inference",
    "type": "http in",
    "z": "tab_tie_detection",
    "name": "POST /inference-result",
    "url": "/inference-result",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 160,
    "y": 140,
    "wires": [
      [
        "http_resp_ok",
        "fn_parse_payload",
        "debug_log"
      ]
    ]
  },
  {
    "id": "http_resp_ok",
    "type": "http response",
    "z": "tab_tie_detection",
    "name": "200 OK",
    "statusCode": "200",
    "headers": {
      "content-type": "application/json"
    },
    "x": 420,
    "y": 80,
    "wires": []
  },
  {
    "id": "debug_log",
    "type": "debug",
    "z": "tab_tie_detection",
    "name": "Log Webhook Inferencia",
    "active": false,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 470,
    "y": 140,
    "wires": []
  },
  {
    "id": "fn_parse_payload",
    "type": "function",
    "z": "tab_tie_detection",
    "name": "Descomponer Métricas",
    "func": "const p = msg.payload || {};\n\n// Mensaje para el estado visual\nconst msgStatus = {\n    payload: {\n        status: p.status || 'SIN CORBATA',\n        confidence: p.confidence || 0.0,\n        has_tie: p.has_tie || false,\n        model_used: p.model_used || 'N/A'\n    }\n};\n\n// Mensaje para indicador de latencia\nconst msgLatency = {\n    payload: Math.round(p.transit_latency_ms || 0)\n};\n\n// Mensaje para FPS\nconst msgFps = {\n    payload: p.fps || 0\n};\n\n// Mensaje para Throughput\nconst msgThroughput = {\n    payload: Math.round(p.throughput_kbps || 0)\n};\n\nreturn [msgStatus, msgLatency, msgFps, msgThroughput];",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 240,
    "wires": [
      [
        "ui_alert_template"
      ],
      [
        "ui_latency_gauge",
        "ui_latency_chart"
      ],
      [
        "ui_fps_text"
      ],
      [
        "ui_throughput_text"
      ]
    ]
  },
  {
    "id": "ui_alert_template",
    "type": "ui_template",
    "z": "tab_tie_detection",
    "group": "ui_group_status",
    "name": "Badge Alerta Visual",
    "order": 1,
    "width": "6",
    "height": "4",
    "format": "<div style=\"padding: 1.5rem; border-radius: 12px; text-align: center; font-weight: bold; font-family: sans-serif; transition: all 0.3s ease;\"\n     ng-style=\"{\n       'background': msg.payload.has_tie ? 'rgba(34, 197, 94, 0.2)' : 'rgba(239, 68, 68, 0.2)',\n       'border': msg.payload.has_tie ? '3px solid #22c55e' : '3px solid #ef4444',\n       'color': msg.payload.has_tie ? '#4ade80' : '#f87171'\n     }\">\n  <div style=\"font-size: 2rem; margin-bottom: 0.5rem;\">\n    {{ msg.payload.has_tie ? '🟢 CON CORBATA' : '🔴 SIN CORBATA' }}\n  </div>\n  <div style=\"font-size: 1.1rem; color: #cbd5e1;\">\n    Confianza: {{ (msg.payload.confidence * 100) | number:0 }}%\n  </div>\n  <div style=\"font-size: 0.85rem; color: #94a3b8; margin-top: 0.5rem;\">\n    Motor: {{ msg.payload.model_used }}\n  </div>\n</div>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 740,
    "y": 180,
    "wires": [
      []
    ]
  },
  {
    "id": "ui_latency_gauge",
    "type": "ui_gauge",
